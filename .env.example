# Основной маршрут: gemini | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Для gemini оставить пустым.
# Для openai_compatible указать полный базовый адрес API (например, http://localhost:1234/v1).
LLM_BASE_URL=

# json_schema | json_prompt
LLM_OUTPUT_MODE=json_schema

# Тайм-аут одного API-запроса в секундах
LLM_TIMEOUT_SECONDS=120

# Число повторов после первой попытки при временных ошибках
LLM_MAX_RETRIES=2

# Необязательный резервный маршрут
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=http://localhost:1234/v1
LLM_FALLBACK_OUTPUT_MODE=json_prompt
